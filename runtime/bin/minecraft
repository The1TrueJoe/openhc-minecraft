#!/bin/bash
# minecraft [USERNAME] — start vanilla Minecraft on the panel, offline mode.
#
# Java 8, 32-bit (the GPU userspace is 32-bit); LWJGL 2 opens its window on the
# Xvfb display and gets its GL from gl4es (gl4es-run), which draws to the panel.
# Env: MC_VERSION (1.7.10), MC_XMX (heap, 768M), MC_WIDTH/MC_HEIGHT (panel size).
V=${MC_VERSION:-1.7.10}
G=/opt/minecraft
. "$G/$V.launch" || exit 1
cd "$G"
# First run: settings that suit a 1.2 GHz Atom and a 720x480 panel. The game
# rewrites this file itself afterwards, so later changes made in-game stick.
# Render distance 3: the SGX545 is limited by the triangles it is given, so the
# view distance sets the frame rate (measured on an EA1: 2 chunks ~54 FPS,
# 3 ~42, 4 ~29).
[ -f options.txt ] || cat > options.txt <<OPT
renderDistance:3
fancyGraphics:false
ao:0
particles:2
clouds:false
fboEnable:false
enableVsync:false
mipmapLevels:0
maxFps:60
guiScale:2
pauseOnLostFocus:false
snooperEnabled:false
OPT
CPA=$(echo "$CP" | sed "s|libraries/|$G/libraries/|g; s|versions/|$G/versions/|g")
# Headless AWT: the game's window is LWJGL's own X window, so it needs no AWT
# display — and initialising AWT's X11 toolkit in this process (with the DDK's
# bus-id shim preloaded) segfaults the JVM before the game starts.
# -server: this JRE has the optimising C2 compiler, but the JVM only picks it on
# a "server-class" machine (2 GB or more); the EA has 1.78 GB, and C1 code runs
# the game's world logic markedly slower.
# -Xss1M: a 32-bit JVM's default 320K thread stack overflows in world generation's
# neighbour updates (the official launcher passes the same on x86).
# processReaperUseDefaultStackSize: Java 8 starts its process reaper on a 32K
# stack, too small once the DDK's thread-local storage is loaded — and the
# integrated server execs `id -u` (netty) when a world starts.
exec /usr/local/bin/gl4es-run /opt/java/jre8/bin/java -server \
  -Xss1M -Xms256M -Xmx"${MC_XMX:-768M}" -XX:+UseConcMarkSweepGC -Djava.awt.headless=true \
  -Djdk.lang.processReaperUseDefaultStackSize=true \
  -Djava.library.path="$G/natives" \
  -Dorg.lwjgl.opengl.libname=/usr/lib/gl4es/libGL.so.1 \
  -cp "$CPA" "$MAIN" \
  --username "${1:-Player}" --version "$V" --gameDir "$G" --assetsDir "$G/assets" \
  --assetIndex "$ASSET_INDEX" --uuid 00000000000000000000000000000000 --accessToken 0 \
  --userProperties {} --userType legacy \
  --width "${MC_WIDTH:-720}" --height "${MC_HEIGHT:-480}"
