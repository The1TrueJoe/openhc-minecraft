#!/bin/sh
# gl4es-run CMD... — run a desktop-GL program on the SGX545 through gl4es.
#
# gl4es turns OpenGL 2.1 into GLES2 and, in framebuffer mode (LIBGL_FB=1),
# draws to the panel through the DDK's LinuxFB EGL instead of into the X window;
# X (Xvfb) is only there for LWJGL's window and input.
#   LIBGL_KEEPEGL  never eglTerminate the probe display — DDK 1.7 cannot
#                  eglInitialize again in the same process (our gl4es patch).
#   LIBGL_DEEPBIND=0  load the DDK without RTLD_DEEPBIND, so openHC's bus-id
#                  shim (LD_PRELOAD, from the box's DDK) still reaches libsrv_um.
export LIBGL_KEEPEGL=1 LIBGL_DEEPBIND=0 LIBGL_FB=1 LIBGL_ES=2 LIBGL_GL=21 LIBGL_NOBANNER=1
export LIBGL_EGL=/usr/lib/sgx/libEGL.so.1 LIBGL_GLES=/usr/lib/sgx/libGLESv2.so.2
export LD_LIBRARY_PATH=/usr/lib/gl4es:/usr/lib/sgx${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export LD_PRELOAD=/usr/lib/sgx/sgx-busidshim.so
export DISPLAY=${DISPLAY:-:0}
exec "$@"
