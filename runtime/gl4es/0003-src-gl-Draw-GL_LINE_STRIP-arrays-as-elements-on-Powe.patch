From c7ddb9e486a55d93120b0017742a432c6893dbc3 Mon Sep 17 00:00:00 2001
From: Joseph Telaak <jttelaak@hotmail.com>
Date: Tue, 27 Oct 2026 22:39:09 -0400
Subject: [PATCH 3/3] src/gl: Draw GL_LINE_STRIP arrays as elements on PowerVR
 SGX 545

---
 USAGE.md      |  5 +++++
 src/gl/fpe.c  | 44 ++++++++++++++++++++++++++++++++++++++++++--
 src/gl/init.c | 12 ++++++++++++
 src/gl/init.h |  1 +
 4 files changed, 60 insertions(+), 2 deletions(-)

diff --git a/USAGE.md b/USAGE.md
index 12945b8d..a3b950d6 100644
--- a/USAGE.md
+++ b/USAGE.md
@@ -390,3 +390,8 @@ Blit to FB 0 force a SwapBuffer
 Use RTLD_DEEPBIND when loading EGL and GLES library
 * 0 : Default except on PYRA, use RTLD_DEEPBIND when loading EGL/GLES libraries
 * 1 : Default only on PYRA, don't use RTLD_DEEPBIND when loading EGL/GLES libraries
+
+##### LIBGL_NOLINESTRIP
+Draw GL_LINE_STRIP from glDrawArrays with glDrawElements and sequential indices (GLES2 backend only)
+ * 0 : Default, except on PowerVR SGX 545: use glDrawArrays as is
+ * 1 : Default on PowerVR SGX 545, whose driver (DDK 1.7) draws GL_LINE_STRIP from glDrawArrays wrong. Off when LIBGL_NOTEST=1 (the renderer is unknown then) unless set explicitly
diff --git a/src/gl/fpe.c b/src/gl/fpe.c
index 8be24faf..76d2620d 100644
--- a/src/gl/fpe.c
+++ b/src/gl/fpe.c
@@ -818,12 +818,51 @@ void APIENTRY_GL4ES fpe_glNormal3f(GLfloat nx, GLfloat ny, GLfloat nz) {
     noerrorShim();
 }
 
+// LIBGL_NOLINESTRIP: PowerVR SGX 545 (DDK 1.7) draws GL_LINE_STRIP from glDrawArrays wrong (only every other
+// segment, plus a stray one), while glDrawElements(GL_LINE_STRIP) is right: draw the strip through sequential indices
+static int fpe_linestrip_by_elements(GLenum mode, GLint first, GLsizei count) {
+    static GLushort* sequence = NULL;   // 0..65535, shared by every short strip
+    if(!globals4es.nolinestrip || mode!=GL_LINE_STRIP || count<2 || first<0)
+        return 0;
+    const unsigned long long last = (unsigned long long)first + count - 1;
+    const int use_uint = (last>65535);
+    if(use_uint && (!hardext.elementuint || last>0xffffffffull))
+        return 0;
+    if(!use_uint && !sequence) {
+        sequence = (GLushort*)malloc(65536*sizeof(GLushort));
+        if(!sequence)
+            return 0;
+        for(int i=0; i<65536; ++i)
+            sequence[i] = i;
+    }
+    GLuint* idx = NULL;
+    if(use_uint) {
+        idx = (GLuint*)malloc(count*sizeof(GLuint));
+        if(!idx)
+            return 0;
+        for(int i=0; i<count; ++i)
+            idx[i] = first+i;
+    }
+    DBG(printf("fpe_linestrip_by_elements(%d, %d)\n", first, count);)
+    LOAD_GLES(glDrawElements);
+    GLuint old_buffer = wantBufferIndex(0);   // the indices are client side
+    realize_bufferIndex();
+    if(use_uint)
+        gles_glDrawElements(GL_LINE_STRIP, count, GL_UNSIGNED_INT, idx);
+    else
+        gles_glDrawElements(GL_LINE_STRIP, count, GL_UNSIGNED_SHORT, sequence+first);
+    wantBufferIndex(old_buffer);
+    free(idx);
+    return 1;
+}
+
 void APIENTRY_GL4ES fpe_glDrawArrays(GLenum mode, GLint first, GLsizei count) {
     DBG(printf("fpe_glDrawArrays(%s, %d, %d), program=%d, instanceID=%u\n", PrintEnum(mode), first, count, glstate->glsl->program, glstate->instanceID);)
     scratch_t scratch = {0};
     realize_glenv(mode==GL_POINTS, first, count, 0, NULL, &scratch);
     LOAD_GLES(glDrawArrays);
-    gles_glDrawArrays(mode, first, count);
+    if(!fpe_linestrip_by_elements(mode, first, count))
+        gles_glDrawArrays(mode, first, count);
     free_scratch(&scratch);
 }
 
@@ -891,7 +930,8 @@ void APIENTRY_GL4ES fpe_glDrawArraysInstanced(GLenum mode, GLint first, GLsizei
                 }
             }
         }
-        gles_glDrawArrays(mode, first, count);
+        if(!fpe_linestrip_by_elements(mode, first, count))
+            gles_glDrawArrays(mode, first, count);
     }
     free_scratch(&scratch);
 }
diff --git a/src/gl/init.c b/src/gl/init.c
index 847803e1..9c26f8bc 100644
--- a/src/gl/init.c
+++ b/src/gl/init.c
@@ -1,4 +1,5 @@
 #include <stdio.h>
+#include <string.h>
 #ifndef _WIN32
 #include <unistd.h>
 #else
@@ -17,6 +18,9 @@
 #include "fpe_cache.h"
 #include "init.h"
 #include "envvars.h"
+
+extern char* gl4es_original_renderer;
+
 #if defined(__EMSCRIPTEN__) || defined(__APPLE__)
 #define NO_INIT_CONSTRUCTOR
 #endif
@@ -462,6 +466,14 @@ void initialize_gl4es() {
         }
       }
 
+    // PowerVR SGX 545 (DDK 1.7) draws GL_LINE_STRIP from glDrawArrays wrong; glDrawElements is right
+    GetEnvVarBool("LIBGL_NOLINESTRIP", &globals4es.nolinestrip, hardext.esversion>1 && (hardext.vendor&VEND_IMGTEC)
+        && gl4es_original_renderer && strstr(gl4es_original_renderer, "SGX 545"));
+    if(hardext.esversion==1)
+        globals4es.nolinestrip = 0;
+    if(globals4es.nolinestrip)
+        SHUT_LOGD("Line strips from glDrawArrays will be drawn with glDrawElements\n");
+
     if(GetEnvVarBool("LIBGL_AVOID16BITS", &globals4es.avoid16bits, (hardext.vendor&VEND_IMGTEC)?0:1)) {
       if(globals4es.avoid16bits) {
         SHUT_LOGD("Avoid 16bits textures\n");
