From 3157ea0dc0b93c50d599c7c2e027831fb958d612 Mon Sep 17 00:00:00 2001
From: Joseph Telaak <jttelaak@hotmail.com>
Date: Wed, 28 Oct 2026 02:32:26 -0400
Subject: [PATCH] src/gl: Accept GL_TEXTURE_MAX_ANISOTROPY as a no-op without
 anisotropic filtering

---
 src/gl/texture_params.c | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/src/gl/texture_params.c b/src/gl/texture_params.c
index 96e07205..3790b19e 100644
--- a/src/gl/texture_params.c
+++ b/src/gl/texture_params.c
@@ -329,14 +329,16 @@ void APIENTRY_GL4ES gl4es_glTexParameterfv(GLenum target, GLenum pname, const GL
                 }
                 break;  // fallback to calling actual glTexParameteri
             case GL_TEXTURE_MAX_ANISOTROPY:
-                if(!hardext.aniso) {
-                    errorShim(GL_INVALID_ENUM);
-                    return;
-                }
                 if(param<0){
                     errorShim(GL_INVALID_VALUE);
                     return;
                 }
+                if(!hardext.aniso) {
+                    // Not advertised, but some programs (Minecraft 1.7.10) set it unconditionally
+                    // when they draw: accept it as a no-op instead of an error every frame.
+                    noerrorShim();
+                    return;
+                }
                 if(param>hardext.aniso) param=hardext.aniso;
                 texture->aniso = param;
                 break;
@@ -580,7 +582,7 @@ void APIENTRY_GL4ES gl4es_glGetTexLevelParameterfv(GLenum target, GLint level, G
                 break;
             case GL_TEXTURE_MAX_ANISOTROPY:
                 if(!hardext.aniso)
-                    errorShim(GL_INVALID_ENUM);
+                    (*params) = 1.0f;   // no anisotropic filtering, see glTexParameterfv
                 else
                     (*params) = bound->aniso;
                 break;
-- 
