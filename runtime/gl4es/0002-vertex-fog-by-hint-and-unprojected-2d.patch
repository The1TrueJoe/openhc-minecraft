 }
 
+// Is the q of texture unit i's coordinates known to be 1 for this draw? Then a 2D
+// texture can be sampled with texture2D on .st instead of texture2DProj: on some
+// GPUs (PowerVR SGX) a projected lookup is a dependent read, a plain one is not.
+static int fpe_texcoord_q_is_one(int i) {
+    if(glstate->fpe_state->texgen[i].texgen_q)
+        return 0;
+    if(glstate->fpe_state->texture[i].texmat) {
+        const GLfloat *m = getTexMat(i);    // column-major: q' = m[3]s + m[7]t + m[11]r + m[15]q
+        if(m[3]!=0.f || m[7]!=0.f || m[11]!=0.f || m[15]!=1.f)
+            return 0;
+    }
+    const vertexattrib_t *v = &glstate->vao->vertexattrib[ATT_MULTITEXCOORD0+i];
+    if(v->enabled)
+        return v->size<4;
+    return glstate->vavalue[ATT_MULTITEXCOORD0+i][3]==1.f;
+}
