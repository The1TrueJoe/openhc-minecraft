+// Are all of list's texcoord q for unit a equal to 1? Evaluated once: a list does not
+// change once it is drawn.
+static int list_tex_q_is_one(renderlist_t *list, int a) {
+    if (!list->tex_q1[a]) {
+        const int stride = list->tex_stride[a] ? list->tex_stride[a]>>2 : 4;
+        const GLfloat *q = list->tex[a]+3;
+        int one = 1;
+        for (int i=0; i<list->len && one; i++, q+=stride)
+            one = (*q==1.0f);
+        list->tex_q1[a] = one?1:2;
+    }
+    return list->tex_q1[a]==1;
+}
