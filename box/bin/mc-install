#!/bin/sh
# mc-install [RUNTIME] — install (or update) the game runtime and the game.
#
# RUNTIME is a runtime-amd64.tar.xz path or URL; default: this repo's latest
# release. Then the game itself is downloaded from Mojang by mc-get-game inside
# the runtime. Re-running is safe: worlds, options, OptiFine and already-downloaded
# game files are kept; the rest of the old root is replaced.
#
# Needs ~900 MB free on /. openHC grows its root filesystem to fill the eMMC
# partition at boot (S03growfs), so any current EA image has several GB.
set -e
M=/opt/minecraft
R=$M/rootfs
URL=https://github.com/The1TrueJoe/openhc-minecraft/releases/latest/download/runtime-amd64.tar.xz
SRC=${1:-$URL}
NEED_MB=900

log() { echo "mc-install: $*"; }
free_mb() { df -m "$1" | awk 'NR==2 {print $4}'; }

# 1. the runtime tarball, into RAM (/tmp is tmpfs)
case "$SRC" in
	http://*|https://*)
		log "downloading $SRC"
		"$M/bin/mc-fetch" "$SRC" /tmp/runtime-amd64.tar.xz
		TARBALL=/tmp/runtime-amd64.tar.xz ;;
	*)	TARBALL=$SRC ;;
esac
[ -r "$TARBALL" ] || { log "no runtime at $TARBALL"; exit 1; }

# 2. room on /
if [ "$(free_mb /)" -lt $NEED_MB ]; then
	log "only $(free_mb /) MB free on /, need $NEED_MB — is this openHC image older than S03growfs?"
	exit 1
fi

# 3. a fresh root: the game's own data (opt/minecraft: worlds, options, OptiFine,
#    downloaded game files) moves aside, the old root goes, the new one is
#    unpacked and the data moves back. The runtime's own files there (the game's
#    file list and launch info) win.
G=$M/game-data
for m in dev proc sys tmp; do mountpoint -q "$R/$m" && umount "$R/$m" 2>/dev/null; done
if grep -q " $R/" /proc/mounts; then
	log "something is still mounted under $R — stop the game (mc-session stop) and retry"
	exit 1
fi
[ -d "$R/opt/minecraft" ] && [ ! -e "$G" ] && mv "$R/opt/minecraft" "$G"
rm -rf "$R"
mkdir -p "$R"
log "unpacking the runtime"
xz -dc "$TARBALL" | tar x -C "$R"
[ "$TARBALL" = /tmp/runtime-amd64.tar.xz ] && rm -f "$TARBALL"
if [ -d "$G" ]; then
	mkdir -p "$R/opt/minecraft"
	for e in "$G"/* "$G"/.[!.]*; do
		[ -e "$e" ] || continue
		[ -e "$R/opt/minecraft/${e##*/}" ] || mv "$e" "$R/opt/minecraft/"
	done
	rm -rf "$G"
fi
cat "$R/etc/openhc-minecraft-runtime" 2>/dev/null

# 4. the game, from Mojang
for m in dev proc sys tmp; do
	mountpoint -q "$R/$m" && continue
	case $m in
		proc) mount -t proc proc "$R/proc" ;;
		sys)  mount -t sysfs sys "$R/sys" ;;
		*)    mount --bind "/$m" "$R/$m" ;;
	esac
done
cp -L /etc/resolv.conf "$R/etc/resolv.conf" && chmod 644 "$R/etc/resolv.conf"
chroot "$R" /usr/bin/env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin /usr/local/bin/mc-get-game
log "done — start it with: mc-session start   (or enable autostart: touch $M/autostart)"
