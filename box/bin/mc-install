#!/bin/sh
# mc-install [RUNTIME] — install (or update) the game runtime and the game.
#
# RUNTIME is a runtime-i386.tar.xz path or URL; default: this repo's latest
# release. Then the game itself is downloaded from Mojang by mc-get-game inside
# the runtime. Re-running is safe: worlds, options.txt and already-downloaded
# game files are kept.
#
# Needs ~900 MB free on /. openHC grows its root filesystem to fill the eMMC
# partition at boot (S03growfs), so any current EA image has several GB.
set -e
M=/opt/minecraft
R=$M/rootfs
URL=https://github.com/The1TrueJoe/openhc-minecraft/releases/latest/download/runtime-i386.tar.xz
SRC=${1:-$URL}
NEED_MB=900

log() { echo "mc-install: $*"; }
free_mb() { df -m "$1" | awk 'NR==2 {print $4}'; }

# 1. the runtime tarball, into RAM (/tmp is tmpfs)
case "$SRC" in
	http://*|https://*)
		log "downloading $SRC"
		"$M/bin/mc-fetch" "$SRC" /tmp/runtime-i386.tar.xz
		TARBALL=/tmp/runtime-i386.tar.xz ;;
	*)	TARBALL=$SRC ;;
esac
[ -r "$TARBALL" ] || { log "no runtime at $TARBALL"; exit 1; }

# 2. room on /
if [ "$(free_mb /)" -lt $NEED_MB ]; then
	log "only $(free_mb /) MB free on /, need $NEED_MB — is this openHC image older than S03growfs?"
	exit 1
fi

# 3. unpack over any previous runtime (game data under opt/minecraft survives:
#    the tarball only carries the file list and launch info there)
mkdir -p "$R"
for m in dev proc sys tmp; do mountpoint -q "$R/$m" && umount "$R/$m" 2>/dev/null; done
log "unpacking the runtime"
xz -dc "$TARBALL" | tar x -C "$R"
[ "$TARBALL" = /tmp/runtime-i386.tar.xz ] && rm -f "$TARBALL"
cat "$R/etc/openhc-minecraft-runtime" 2>/dev/null

# 4. the game, from Mojang
for m in dev proc sys tmp; do
	mountpoint -q "$R/$m" && continue
	case $m in
		proc) mount -t proc proc "$R/proc" ;;
		sys)  mount -t sysfs sys "$R/sys" ;;
		*)    mount --bind "/$m" "$R/$m" ;;
	esac
done
cp -L /etc/resolv.conf "$R/etc/resolv.conf"
chroot "$R" /usr/bin/env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin /usr/local/bin/mc-get-game
log "done — start it with: mc-session start   (or enable autostart: touch $M/autostart)"
