#!/bin/sh
# mc-session {start|stop|run|status} [USERNAME] — Minecraft on the HDMI/panel output.
#
# The game runs in the runtime under /opt/minecraft/rootfs (see
# runtime/build-runtime.sh), on the GPU through powervr_sgx and the root's Mesa.
# A session:
#   1. takes the panel from the on-screen web view (S95ohc-display), if it runs;
#   2. starts Xorg on the panel, mc-inputd (USB keyboards, mice and pads -> X)
#      and the game;
#   3. when the game exits, stops both and gives the panel back.
# "start" runs all of that in the background (log: /var/log/minecraft.log),
# "run" in the foreground, "stop" ends a running session.
M=/opt/minecraft
R=$M/rootfs
PIDF=/run/mc-session.pid
LOG=/var/log/minecraft.log
DPY=:0

log() { echo "mc-session: $*"; }

# The root's Mesa needs the open SGX kernel driver at the uAPI it was built for
# (runtime/build-runtime.sh: MESA_VERSION, MESA_UAPI_MAJOR); mc-gpucheck asks the
# driver. Needs the root's /dev, so after mounts.
gpu_check() {
	for n in /sys/class/drm/renderD*; do
		case "$(readlink "$n/device/driver" 2>/dev/null)" in
			*/powervr_sgx) inchroot /usr/local/bin/mc-gpucheck && return 0; return 1 ;;
		esac
	done
	log "no powervr_sgx GPU driver on this box — the game needs openHC's open SGX stack"
	return 1
}

# The game's sound plays through openHC: ohc-audiod writes the box's
# /etc/asound.conf, whose `default` is the board's first output (HDMI on an
# EA1) through that output's level, duck and dmix, so the game shows up in the
# box's volume and mixes with Spotify and AirPlay. The root's own alsa-lib reads
# a copy. One stage cannot come along: the software tone plugin (`type ohceq`)
# is built against the box's own libraries, not the root's, so each tone stage
# is replaced by a straight pass to the PCM below it. Without an
# asound.conf (audiod not running) the root has none either and the game is
# silent, which is what the box would do for any other program.
audio_conf() {
	rm -f "$R/etc/asound.conf"
	[ -r /etc/asound.conf ] || { log "no /etc/asound.conf on the box — no sound"; return; }
	{
		cat /etc/asound.conf
		awk '/^pcm\.[A-Za-z0-9_]+ \{/ { name = $1; sub(/^pcm\./, "", name) }
		     /type ohceq/ { eq = name }
		     eq != "" && /slave\.pcm/ {
			print "pcm.!" eq " { type plug slave.pcm " $2 " }"; eq = "" }' /etc/asound.conf
	} > "$R/etc/asound.conf"
}

mounts() {
	for m in dev proc sys tmp; do
		mountpoint -q "$R/$m" && continue
		mkdir -p "$R/$m"
		case $m in
			proc) mount -t proc proc "$R/proc" ;;
			sys)  mount -t sysfs sys "$R/sys" ;;
			*)    mount --bind "/$m" "$R/$m" ;;
		esac
	done
	cp -L /etc/resolv.conf "$R/etc/resolv.conf" 2>/dev/null
	audio_conf
	mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix
}

inchroot() {
	chroot "$R" /usr/bin/env -i HOME=/root TERM=linux DISPLAY=$DPY \
		PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin "$@"
}

panel_size() {
	s=$(cat /sys/class/drm/card0-*/modes 2>/dev/null | head -n 1)
	W=${s%x*}; H=${s#*x}
	[ -n "$s" ] || { s=$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null); W=${s%,*}; H=${s#*,}; }
	[ -n "$W" ] && [ -n "$H" ] || { W=720; H=480; }
}

run() {
	[ -x "$R/usr/local/bin/minecraft" ] || { log "not installed — run mc-install"; exit 1; }
	mounts
	gpu_check || exit 1
	panel_size

	# The web view and the game cannot share the panel.
	display_was_on=0
	if [ -f /run/ohc-display.pid ] && kill -0 "$(cat /run/ohc-display.pid)" 2>/dev/null; then
		display_was_on=1
		/etc/init.d/S95ohc-display stop >/dev/null 2>&1
		killall webview WPEWebProcess WPENetworkProcess 2>/dev/null
	fi

	rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
	# -s 0 -dpms: the panel never blanks while the game runs.
	inchroot /usr/lib/xorg/Xorg $DPY -nolisten tcp -noreset -s 0 -dpms \
		-config /etc/X11/xorg.conf -logfile /tmp/mc-xorg.log >/tmp/mc-xorg.out 2>&1 &
	xorg=$!
	i=0; while [ ! -S /tmp/.X11-unix/X0 ] && [ $i -lt 100 ]; do sleep 0.2; i=$((i+1)); done
	inputd=
	if [ -S /tmp/.X11-unix/X0 ]; then
		DISPLAY=$DPY "$M/bin/mc-inputd" &
		inputd=$!
		log "playing on ${W}x${H}"
		MC_WIDTH=$W MC_HEIGHT=$H inchroot /usr/bin/env MC_WIDTH=$W MC_HEIGHT=$H \
			/usr/local/bin/minecraft "${1:-Player}"
		log "game exited ($?)"
	else
		log "Xorg did not start (/tmp/mc-xorg.log)"
	fi

	kill $inputd $xorg 2>/dev/null
	wait $inputd $xorg 2>/dev/null
	if [ $display_was_on = 1 ]; then
		/etc/init.d/S95ohc-display start >/dev/null 2>&1
	elif [ -x /etc/init.d/S01splash ]; then
		/etc/init.d/S01splash start >/dev/null 2>&1
	fi
}

case "$1" in
	run)
		shift; run "$@" ;;
	start)
		shift
		if [ -f $PIDF ] && kill -0 "$(cat $PIDF)" 2>/dev/null; then
			log "already running"; exit 0
		fi
		setsid "$0" run "$@" </dev/null >>$LOG 2>&1 &
		echo $! > $PIDF ;;
	stop)
		# Ending the game ends the session; run() then cleans up behind it
		# (Xorg, mc-inputd, handing the panel back). Give it time to, and only
		# then sweep whatever is left.
		killall java 2>/dev/null
		if [ -f $PIDF ]; then
			pid=$(cat $PIDF); i=0
			while kill -0 "$pid" 2>/dev/null && [ $i -lt 20 ]; do sleep 0.5; i=$((i+1)); done
			kill "$pid" 2>/dev/null
		fi
		killall Xorg mc-inputd 2>/dev/null
		rm -f $PIDF ;;
	status)
		if [ -f $PIDF ] && kill -0 "$(cat $PIDF)" 2>/dev/null; then echo running; else echo stopped; exit 1; fi ;;
	*)
		echo "usage: $0 {start|stop|run|status} [USERNAME]"; exit 1 ;;
esac
